# ==============================================================================
# FLOODWISE CONFIGURATION TEMPLATE
# Copy this file to `.env` (or `backend/.env`) and fill in your actual values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Earth Engine & Copernicus (Data Sources)
# ------------------------------------------------------------------------------

# Google Cloud Project ID with Earth Engine API enabled.
# Required for running ndwi_timeseries.py to generate NDWI graphs.
# You also need to run `earthengine authenticate` on your machine once.
EE_PROJECT=your_gcp_project_id_here

# Copernicus Data Space Ecosystem Credentials
# Required for fetching real DEM and Precipitation data in data_collector.py
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here

# ------------------------------------------------------------------------------
# 2. Database
# ------------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://floodwise:floodwise@localhost:5432/floodwise

# ------------------------------------------------------------------------------
# 3. Backend & Security
# ------------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=info
API_BASE_URL=http://localhost:8000

# Secret key for JWT token generation. Keep this secret in production!
SECRET_KEY=replace_this_with_a_secure_random_string_for_production
ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 4. Frontend (Vite App)
# ------------------------------------------------------------------------------

# The URL where the frontend expects the backend API to be running
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. Notifications (Optional)
# ------------------------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_USE_TLS=true
