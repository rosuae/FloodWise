# ==============================================================================
# FLOODWISE CONFIGURATION TEMPLATE
# Copy this file to `.env` (or `backend/.env`) and fill in your actual values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Earth Engine & Copernicus (Data Sources)
# ------------------------------------------------------------------------------

# Google Cloud Project ID with Earth Engine API enabled.
# Required for running ndwi_timeseries.py to generate NDWI graphs.
# You also need to run `earthengine authenticate` on your machine once.
EE_PROJECT=your_gcp_project_id_here

# Copernicus Data Space Ecosystem Credentials
# Required for fetching real DEM and Precipitation data in data_collector.py
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here

# ------------------------------------------------------------------------------
# 2. Database
# ------------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://floodwise:floodwise@localhost:5432/floodwise

# ------------------------------------------------------------------------------
# 3. Backend & Security
# ------------------------------------------------------------------------------

APP_ENV=development
DATABASE_URL=postgresql+psycopg://floodwise:floodwise@localhost:5432/floodwise
# CDSE OAuth2 credentials
CDSE_CLIENT_ID=your_cdse_client_id
CDSE_CLIENT_SECRET=your_cdse_client_secret

# If you authenticate via Copernicus dashboard token/API key, set this and you can skip OAuth creds
# CDSE_ACCESS_TOKEN=your_bearer_token
# COPERNICUS_API_KEY=your_api_key_or_token

# Optional aliases accepted by the pipeline
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# COPERNICUS_USER_ID=your_cdse_client_id
# COPERNICUS_USER_SECRET=your_cdse_client_secret
# copernicus_user_id=your_cdse_client_id
# copernicus_user_secret=your_cdse_client_secret
# COPERNICUS_ACCESS_TOKEN=your_bearer_token

# Optional explicit paths
FLOODWISE_INPUT_CSV=data/raw/evenimente_baza.csv
FLOODWISE_OUTPUT_CSV=data/groundwater_ml_dataset_final.csv
FLOODWISE_DEM_PATH=data/raw/copernicus_dem.tif
FLOODWISE_SLOPE_PATH=data/raw/copernicus_slope.tif
FLOODWISE_GLHYMPS_PATH=data/raw/glhymps.gpkg

# Network timeout per request (seconds)
FLOODWISE_REQUEST_TIMEOUT=30
